NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. From Supabase project settings > API > service_role. Bypasses
# RLS entirely — used only by the admin "create driver account" action
# (src/lib/supabase/admin.ts). NEVER prefix this with NEXT_PUBLIC_ and never
# reference it from a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to build password-reset email links when NEXT_PUBLIC_SITE_URL differs
# from the request origin (e.g. behind a proxy). Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phone number dialled by the "Contact the on-duty manager" button on the
# Emergency Help page. E.164 format, e.g. +447700900000. Leave unset to show
# a configuration notice instead of a broken/empty button.
NEXT_PUBLIC_COMPANY_EMERGENCY_PHONE=
